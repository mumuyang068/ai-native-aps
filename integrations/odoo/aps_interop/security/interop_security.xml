<odoo>
  <record id="group_test_publisher" model="res.groups">
    <field name="name">APS isolated test publisher</field>
    <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
  </record>
  <record id="rule_company_receipts" model="ir.rule">
    <field name="name">APS receipts in allowed companies</field>
    <field name="model_id" ref="model_aps_interop_command"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('aps_interop.group_test_publisher'))]"/>
  </record>
</odoo>
